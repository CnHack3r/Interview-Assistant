{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "面试官助手PRO",
  "version": "1.1.0",
  "identifier": "com.interview.assistant.pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "面试官助手PRO",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "简历解析 / AI 出题 / 面试评分 / PDF 报告",
    "longDescription": "面向技术面试官的桌面应用：上传候选人简历，AI 结合目标岗位自动生成面试题，面试官在评分工作台上逐题打分，最后导出带毛笔字水印的 PDF 面试评估报告。",
    "resources": {
      "resources/fonts/MaShanZheng-Regular.ttf": "fonts/MaShanZheng-Regular.ttf",
      "resources/fonts/NotoSansSC-Regular.ttf": "fonts/NotoSansSC-Regular.ttf"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese"]
      }
    }
  }
}
